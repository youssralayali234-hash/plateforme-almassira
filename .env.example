# Supabase > Project Settings > Database > Connection string (pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Connexion directe, nécessaire aux migrations Prisma
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
NEXTAUTH_SECRET="REMPLACER_PAR_UNE_CHAINE_ALEATOIRE_DE_32_CARACTERES_MINIMUM"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REMPLACER_PAR_MOT_DE_PASSE_FORT"
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REMPLACER_PAR_CLE_SECRETE_SERVEUR"
SUPABASE_STORAGE_BUCKET="almassira-documents"
